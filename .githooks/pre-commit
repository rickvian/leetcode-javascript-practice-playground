#!/bin/bash
# =============================================================================
# pre-commit: Verify staged test files against reference solutions
# =============================================================================
#
# PURPOSE
#   Block any commit that includes a test file (leetcode-playground/tests/*.test.js)
#   whose expected values do not match the output of the reference solution
#   (leetcode-solutions/*.js). This catches the most common failure mode in this
#   repo: hand-written placeholder values that were never replaced via the
#   verification workflow described in CLAUDE.md.
#
# HIGH-LEVEL FLOW
#   discover_staged_tests
#     └── for each test file:
#           verify_one_test
#             ├── locate matching playground stub + ref solution
#             ├── snapshot stub
#             ├── build injected file (helper classes + ref body + export)
#             ├── overwrite stub, run vitest, capture result
#             ├── restore stub  (always — even on failure)
#             └── report OK / BLOCKED
#     └── print_summary
#
# EXIT CODES
#   0 = no staged tests, or all staged tests verified successfully
#   1 = one or more staged tests failed verification or had no reference solution
# =============================================================================

set -euo pipefail

# Paths relative to repo root (git invokes hooks from repo root).
HOOK_LIB_DIR="$(dirname "$0")/lib"
EXTRACT_HELPER_CLASSES_PY="${HOOK_LIB_DIR}/extract-helper-classes.py"

FAILED=0   # Count of test files that failed verification or had no ref solution.
CHECKED=0  # Count of test files actually run against a ref solution.


# -----------------------------------------------------------------------------
# discover_staged_tests
#   Print the list of staged test files (one per line). Empty output = nothing
#   relevant to verify, hook can exit 0.
# -----------------------------------------------------------------------------
discover_staged_tests() {
    git diff --cached --name-only \
        | grep "^leetcode-playground/tests/.*\.test\.js$" \
        || true   # grep exits 1 on no match; swallow to keep `set -e` happy.
}


# -----------------------------------------------------------------------------
# build_injected_file <playground_file> <ref_file> <output_file>
#   Compose a vitest-runnable file from:
#     [helper data-structure classes from stub, if not already in ref]
#     <reference solution body>
#     <export line from stub>
#
#   The export line is critical: tests `import { foo } from '../NNNN-...'`,
#   so the injected file must re-export the same names as the stub.
# -----------------------------------------------------------------------------
build_injected_file() {
    local playground_file="$1"
    local ref_file="$2"
    local out_file="$3"

    local classes
    classes=$(python3 "$EXTRACT_HELPER_CLASSES_PY" "$playground_file" "$ref_file")

    if [ -n "$classes" ]; then
        printf '%s\n\n' "$classes" > "$out_file"
        cat "$ref_file" >> "$out_file"
    else
        cat "$ref_file" > "$out_file"
    fi

    local export_line
    export_line=$(grep "^export" "$playground_file" || true)
    if [ -n "$export_line" ]; then
        printf '\n%s\n' "$export_line" >> "$out_file"
    fi
}


# -----------------------------------------------------------------------------
# run_vitest_and_check <test_file>
#   Run vitest against a single test file. Echo the captured output on stdout
#   so the caller can decide pass/fail. `|| true` so a non-zero vitest exit
#   does not propagate (we judge pass/fail by parsing the output, not $?).
# -----------------------------------------------------------------------------
run_vitest_and_check() {
    local test_file="$1"
    npx vitest run "$test_file" 2>&1 || true
}


# -----------------------------------------------------------------------------
# vitest_failed <captured_output>
#   Return 0 (true) if vitest output indicates failures.
#   We grep for "N failed" in the summary line — more reliable than $? since
#   we already swallowed the exit code in run_vitest_and_check.
# -----------------------------------------------------------------------------
vitest_failed() {
    echo "$1" | grep -qE "[0-9]+ failed"
}


# -----------------------------------------------------------------------------
# report_blocked <basename> <vitest_output>
#   Print a BLOCKED message with a few diagnostic lines extracted from vitest.
# -----------------------------------------------------------------------------
report_blocked() {
    local basename="$1"
    local result="$2"
    echo ""
    echo "BLOCKED: $basename — test cases don't match reference solution"
    echo "$result" | grep -E "AssertionError|expected|received|✗" | head -8
    echo ""
}


# -----------------------------------------------------------------------------
# verify_one_test <test_file>
#   Full verification workflow for a single staged test file. Updates the
#   global FAILED / CHECKED counters as a side effect. Returns nothing.
#
#   Possible outcomes:
#     - No matching ref solution    → HARD FAIL (FAILED++)
#     - No matching playground stub → SKIP (no counter change)
#     - Vitest failures             → HARD FAIL (FAILED++) + restore stub
#     - Vitest pass                 → OK (CHECKED++) + restore stub
# -----------------------------------------------------------------------------
verify_one_test() {
    local test_file="$1"
    local basename
    basename=$(basename "$test_file" .test.js)
    local playground_file="leetcode-playground/${basename}.js"
    local ref_file
    ref_file=$(ls leetcode-solutions/${basename}.js 2>/dev/null || true)

    # ---- Case A: no reference solution ---------------------------------------
    # Cannot auto-verify. HARD FAIL: contributor must run the manual workflow
    # (implement temp solution, run vitest, confirm, restore stub) and re-stage.
    # Skipping here would defeat the entire purpose of the hook.
    if [ -z "$ref_file" ] || [ ! -f "$ref_file" ]; then
        echo ""
        echo "  WARNING: $basename — no reference solution found."
        echo "  Expected values MUST be verified manually before this commit."
        echo "  Implement a temporary solution, run npx vitest run, confirm outputs, restore stub."
        echo ""
        FAILED=$((FAILED + 1))
        return
    fi

    # ---- Case B: test exists but no playground stub --------------------------
    # Unusual but harmless — nothing to inject into. Skip without failing.
    if [ ! -f "$playground_file" ]; then
        echo "  SKIP (no playground file): $basename"
        return
    fi

    CHECKED=$((CHECKED + 1))

    # In-memory snapshot of the stub. We restore from this AFTER vitest runs
    # so the user's `// implement` placeholder is never left overwritten on
    # disk, even if vitest crashes.
    local original_content
    original_content=$(cat "$playground_file")

    # Build injected file in a temp location, then swap it in.
    local tmp_inject
    tmp_inject=$(mktemp)
    build_injected_file "$playground_file" "$ref_file" "$tmp_inject"
    cp "$tmp_inject" "$playground_file"
    rm "$tmp_inject"

    # Run the single test file against the injected ref solution.
    local result
    result=$(run_vitest_and_check "$test_file")

    # ALWAYS restore the stub before reporting — never leak the ref solution
    # onto the user's working tree, even on failure.
    printf '%s\n' "$original_content" > "$playground_file"

    if vitest_failed "$result"; then
        report_blocked "$basename" "$result"
        FAILED=$((FAILED + 1))
    else
        echo "  OK: $basename"
    fi
}


# -----------------------------------------------------------------------------
# print_summary
#   Final verdict based on FAILED / CHECKED counters. Sets exit code via
#   `exit` so the caller doesn't need to.
# -----------------------------------------------------------------------------
print_summary() {
    if [ "$FAILED" -gt 0 ]; then
        echo ""
        echo "Commit blocked: $FAILED test file(s) unverified or failed."
        echo "For ref solutions: run verification workflow (CLAUDE.md)."
        echo "For no ref solution: implement temp solution, run vitest, confirm outputs, restore stub."
        exit 1
    fi

    if [ "$CHECKED" -gt 0 ]; then
        echo "  All $CHECKED test file(s) verified against reference solutions."
    fi

    exit 0
}


# =============================================================================
# Main
# =============================================================================
main() {
    local staged_tests
    staged_tests=$(discover_staged_tests)

    # Fast path: nothing relevant staged → let the commit proceed.
    if [ -z "$staged_tests" ]; then
        exit 0
    fi

    # Verify each staged test file in turn.
    for test_file in $staged_tests; do
        verify_one_test "$test_file"
    done

    print_summary
}

main "$@"
